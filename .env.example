# Template for your .env. The easy way to fill it in: from the repo root, run
#     python3 basecamp_setup.py        (Windows: py basecamp_setup.py)
# It asks for your key and writes .env for you. To do it by hand: cp .env.example .env,
# fill in ONE option below, save, re-run the notebook's setup cell.
# .env is gitignored; never commit a key.

# Anthropic API — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=paste-your-key-here

# Amazon Bedrock — set both, and leave ANTHROPIC_API_KEY as the placeholder above.
# AWS_BEARER_TOKEN_BEDROCK=paste-your-bedrock-api-key-here
# AWS_REGION=us-east-1

# Company gateway or proxy — keep the key it issued you above (ANTHROPIC_API_KEY or
# AWS_BEARER_TOKEN_BEDROCK) and add its address. Add the prefix only if the gateway
# expects one in front of model IDs.
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_MODEL_PREFIX=bedrock.anthropic.

# Certificates — set by basecamp_setup.py only if this machine needs it (for example, when
# SSL_CERT_FILE points to a bundle that's missing certificates). Re-test any time with
#     python3 basecamp_setup.py --check-tls    (Windows: py basecamp_setup.py --check-tls)
# BASECAMP_TLS=system+bundle
